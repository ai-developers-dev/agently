# ─── Agently site environment ───
# Copy to .env.local for local dev, or set these in your deployment.

# GoHighLevel inbound webhook. Lead forms (/start-free, /contact, /book-a-demo
# fallback) POST here via /api/lead. Server-only — do NOT prefix with NEXT_PUBLIC.
GHL_WEBHOOK_URL=

# GoHighLevel calendar embed URL used on /book-a-demo. When empty, the page
# shows the lead form instead.
NEXT_PUBLIC_GHL_CALENDAR_URL=

# Where the header "Sign in" link points (your product login).
NEXT_PUBLIC_APP_URL=https://app.agently.net
